# Copy to media/.env (DO NOT COMMIT). Load in PowerShell before running scripts:
#   Get-Content .\media\.env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }

# ElevenLabs
ELEVENLABS_API_KEY=
# Pilih voice pria, muda, santai di ElevenLabs dashboard lalu isi ID-nya.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Cloudflare R2 (aktifkan R2 dulu di dashboard). Dipakai setelah render final.
R2_BUCKET=cfdsemarang-media
# Public base URL r2.dev/custom domain, contoh:
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
R2_VIDEO_PREFIX=instagram/video-1

# CFDSemarang Worker publish
WORKER_BASE=https://cfdsemarang.aidanrn06.workers.dev
ADMIN_PIN=

# Optional: path override
# VIDEO_IN=media/out/cfd-promo.mp4
# VOICE_IN=media/out/voiceover.mp3
# MUSIC_IN=media/assets/music/background.mp3
# VIDEO_OUT=media/out/cfd-promo-final.mp4
